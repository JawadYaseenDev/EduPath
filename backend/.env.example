# Copy to backend/.env and fill in. backend/.env is never committed or shared.
# (scripts/setup.ps1 creates backend/.env for you with a random password.)

# Development only: creates admin@example.com (super admin) and
# verifier@example.com (data verifier) with this password on start-up.
UNIRAH_DEV_STAFF_PASSWORD=choose-a-password-here

# Optional settings
# UNIRAH_RESULT_MODE=extended          # or strict_pdf
# UNIRAH_LOAD_DEMO_DATA=true
# UNIRAH_DATABASE_URL=sqlite:///./dev.db
# UNIRAH_JWT_SECRET=...                # required outside development
